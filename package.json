{
  "name": "paseo-plugin-prompt-studio",
  "description": "A plaintext-first Paseo plugin for drafting, organizing, versioning, and safely dispatching prompts to agents.",
  "private": true,
  "version": "0.0.0",
  "keywords": [
    "paseo",
    "paseo-plugin",
    "prompt-management",
    "prompt-engineering",
    "worklog"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:compiler": "paseo plugin reload prompt-studio --json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@getpaseo/client": "0.10.2",
    "@getpaseo/plugin": "0.10.2",
    "@tanstack/react-query": "^5.90.11",
    "@types/node": "^24.3.0",
    "@types/react": "~19.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
